{
    "name": "@dev/node-assets",
    "private": true,
    "version": "1.0.0",
    "types": "dist/index",
    "main": "dist/index",
    "module": "dist/index",
    "type": "module",
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "npm run compile",
        "test": "vitest run",
        "clean": "rimraf dist && rimraf *.tsbuildinfo -g",
        "precompile": "",
        "compile": "npm run compile:source",
        "compile:source": "tsc -b tsconfig.build.json",
        "watch:source": "tsc -b tsconfig.build.json -w",
        "watch": "build-tools -c dev-watch --packages \"node-assets\" -wa"
    },
    "sideEffects": true,
    "dependencies": {
        "@gltf-transform/core": "^4.4.1",
        "@gltf-transform/extensions": "^4.4.1",
        "@gltf-transform/functions": "^4.4.1",
        "draco3dgltf": "^1.5.7",
        "ktx2-encoder": "^0.5.3",
        "meshoptimizer": "^1.0.1",
        "mikktspace": "^1.1.1",
        "tinyusdz": "0.9.9"
    },
    "devDependencies": {
        "@dev/core": "^1.0.0",
        "@dev/build-tools": "^1.0.0",
        "@types/draco3dgltf": "^1.4.0"
    }
}
