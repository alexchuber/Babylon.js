#usda 1.0
(
    defaultPrim = "RobotArm"
    metersPerUnit = 1
    upAxis = "Y"
)

# Industrial robot arm geometry in OBJ format exported from Blender.
# The MTL and Color texture are colocated with the OBJ.
def Xform "RobotArm"
{
    def Xform "Asset" (
        kind = "reference"
    )
    {
        custom asset assetInfo:source = @./RobotArm/industrial_robot_arm.obj@
        double3 xformOp:translate = (0, 0, 0)
        float3 xformOp:rotateXYZ = (0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }
}
